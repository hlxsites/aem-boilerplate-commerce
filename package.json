{
  "name": "@adobe/aem-boilerplate-commerce",
  "private": true,
  "version": "12.0.0",
  "description": "Starter project for Adobe Commerce on Edge Delivery Services",
  "scripts": {
    "lint:js": "eslint .",
    "lint:css": "stylelint \"blocks/**/*.css\" \"styles/*.css\"",
    "lint": "npm run lint:js && npm run lint:css",
    "lint:fix": "npm run lint:js -- --fix && npm run lint:css -- --fix",
    "start": "aem up",
    "install:dropins": "node build.mjs && node postinstall.js",
    "postinstall": "npm run install:dropins",
    "postupdate": "npm run install:dropins",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hlxsites/aem-boilerplate-commerce.git"
  },
  "author": "Adobe",
  "license": "Apache License 2.0",
  "bugs": {
    "url": "https://github.com/hlxsites/aem-boilerplate-commerce/issues"
  },
  "homepage": "https://github.com/hlxsites/aem-boilerplate-commerce#readme",
  "devDependencies": {
    "@adobe/aem-cli": "16.17.1",
    "@babel/eslint-parser": "7.29.9",
    "@dropins/build-tools": "1.2.2",
    "eslint": "8.57.1",
    "eslint-config-airbnb-base": "15.0.0",
    "eslint-plugin-import": "2.32.0",
    "husky": "^9.1.7",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0"
  },
  "dependencies": {
    "@adobe/adobe-client-data-layer": "3.0.1",
    "@adobe/magento-storefront-event-collector": "1.18.0",
    "@adobe/magento-storefront-events-sdk": "1.18.0",
    "@dropins/storefront-account": "4.3.0-alpha-20261125095209-86e5178",
    "@dropins/storefront-auth": "4.2.0-alpha-20261125095210-54cf4f4",
    "@dropins/storefront-cart": "3.5.0-alpha-20261125095214-22d4d44",
    "@dropins/storefront-checkout": "3.6.0-alpha-20261125095226-29ff83c",
    "@dropins/storefront-order": "5.0.0-alpha-20261125095223-ce2a481",
    "@dropins/storefront-payment-services": "4.3.0",
    "@dropins/storefront-pdp": "3.4.0-alpha-20261109151740",
    "@dropins/storefront-personalization": "3.3.0-alpha-20261125101542-2fd96ed",
    "@dropins/storefront-product-discovery": "3.1.4-alpha-20261125101525",
    "@dropins/storefront-recommendations": "4.2.0-alpha-20261125101525",
    "@dropins/storefront-wishlist": "3.6.0-alpha-20261126100027-b186dc5",
    "@dropins/tools": "3.1.0-alpha-20261118092512"
  },
  "overrides": {
    "@adobe/alloy": {
      "@rollup/plugin-terser": {
        "serialize-javascript": "7.0.5"
      }
    }
  }
}
