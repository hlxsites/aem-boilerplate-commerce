; force @adobe namespaced packages to be installed from npmjs.org
@adobe:registry=https://registry.npmjs.org

; disable npm lifecycle scripts (preinstall/install/postinstall) for every
; installed package as a defense against npm supply-chain attacks that hide
; malicious code in those scripts. Because of this, `npm install` will NOT
; copy drop-in assets or apply GraphQL overrides automatically — run
; `npm run install:dropins` manually afterward. See README.md.
ignore-scripts=true
